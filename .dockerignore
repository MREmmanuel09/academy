# --- Build artefacts / caches ----------------------------------------------
# These are rebuilt inside the image, so copying the host versions just
# busts the Docker layer cache and grows the build context for nothing.
node_modules
.next
.next.bak
.next.bak.*
out
build
dist
coverage
.nyc_output
playwright-report
test-results
.lighthouseci
.vitest-cache
.turbo
.cache

# --- VCS / editor cruft ---------------------------------------------------
.git
.gitignore
.gitattributes
.github
.husky
.vscode
.idea
.DS_Store
Thumbs.db

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Local databases / secrets --------------------------------------------
# Anything DB-shaped should be created inside the container from migrations.
*.db
*.db-journal
*.db-shm
*.db-wal
*.db-shm.bak
*.db-wal.bak
*.db.bak
*.sqlite
*.sqlite-journal
apps/web/data/*.db
apps/web/data/*.db-journal
apps/web/data/*.db-shm
apps/web/data/*.db-wal
apps/web/data/*.bak
# Secrets must never make it into an image.
.env
.env.local
.env.*.local
.env.production
**/secrets.*
**/*.pem
**/*.key

# --- Docker self-references ------------------------------------------------
# Avoid re-including the Docker artefacts in the build context.
Dockerfile
.dockerignore
docker-compose.yml

# --- Test scaffolding ------------------------------------------------------
# Unit/E2E tests + the e2e Playwright browser bundle are dev-only.
tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/**
**/__mocks__/**
playwright.config.ts
vitest.config.ts
