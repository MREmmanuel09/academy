# Homelab deployment env (docker-compose.homelab.yml).
# Copy to `.env` next to the compose file. NEVER commit the real .env.

# REQUIRED — signs sessions (HS256). The container refuses to boot with
# a missing or <32-char secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# REQUIRED — GitHub repo whose CI publishes the GHCR image
# (e.g. your-user/academy). Used as ghcr.io/${IMAGE_REPO}:...
IMAGE_REPO=your-user/academy

# Pin a version (fresh installs: latest). Rollback example: sha-abc1234
IMAGE_TAG=latest

# Public URL users hit. With Tailscale Funnel:
# https://<machine>.<tailnet>.ts.net ; with Cloudflare Tunnel:
# https://academy.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite inside the persisted volume (default shown; usually keep)
# DATABASE_URL=file:/app/apps/web/data/prod.db

# Watchtower poll interval in seconds (300 = check every 5 min)
# WATCHTOWER_POLL=300

# --- Public-service rate limits -------------------------------------
# Defaults: login 5/15min, register 3/hour, api 60/min — counted PER IP.
# Behind Cloudflare Tunnel the real visitor IP is used (CF-Connecting-IP),
# so defaults are fine. Behind Tailscale Funnel visitors may share the
# proxy IP; raise the caps so the whole internet isn't one bucket:
# RATE_LIMIT_REGISTER_MAX=200
# RATE_LIMIT_LOGIN_MAX=100

# Optional notifications for Watchtower (Shoutrrr URL)
# SHOUTRRR_URL=ntfy://topic/...
# SHOUTRRR_URL=discord://token@id

# Timezone for container logs
TZ=UTC
