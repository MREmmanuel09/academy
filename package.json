{
  "name": "academy",
  "version": "0.1.0",
  "private": true,
  "description": "Unified learning platform merging RedLab Academy (DevOps/Data) and Sprint L2 (English).",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter web test:unit",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @academy/db db:generate",
    "db:migrate": "pnpm --filter @academy/db db:migrate",
    "db:push": "pnpm --filter @academy/db db:push",
    "db:seed": "pnpm --filter @academy/db db:seed",
    "db:seed:demo": "pnpm --filter @academy/db db:seed:demo",
    "db:seed:content": "pnpm --filter @academy/db db:seed:content",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.0",
    "sharp": "0.35.4",
    "typescript": "5.6.3"
  }
}
