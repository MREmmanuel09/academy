# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Academy

# Auth.js v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Database (dev: SQLite, prod: PostgreSQL recommended)
# When run from workspace root (npm run db:push), the path is relative to it.
DATABASE_URL="file:./apps/web/data/dev.db"
# DATABASE_URL="postgresql://academy:academy@localhost:5432/academy"

# AI providers (optional, off by default)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# PWA
NEXT_PUBLIC_PWA_ENABLED=true
